#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "antares"
require "json"
require "fileutils"
require_relative "../test/support/lexer_compatibility"

mutations = Integer(ENV.fetch("MUTATIONS", "50"))
tags = ARGV.reject { |argument| argument == "--write" }
lexers = Rouge::Lexer.all.sort_by(&:tag)
lexers.select! { |lexer| tags.include?(lexer.tag) } unless tags.empty?
raise "no matching lexers" if lexers.empty?
results = {}
lexers.each do |lexer|
  result = LexerCompatibility.check(lexer, mutations: mutations)
  results[lexer.tag] = result
  warn "#{lexer.tag}: #{result[:strategy]} (#{result[:checks] - result[:failures]}/#{result[:checks]})#{result[:failure] ? " #{result[:failure][:reason]}" : ''}"
end

if ARGV.include?("--write")
  raise "matrix generation requires all lexers and 50+ mutations" unless tags.empty? && mutations >= 50
  output = +"# frozen_string_literal: true\n\n# Generated by script/compatibility --write; do not edit individual results.\nmodule Antares\n"
  output << "  COMPATIBILITY_VERSION = #{Rouge.version.inspect}.freeze\n  COMPATIBILITY = {\n"
  results.each { |tag, result| output << "    #{tag.inspect} => #{result[:strategy].inspect},\n" }
  output << "  }.freeze\n  COMPATIBILITY_DETAILS = {\n"
  results.each { |tag, result| output << "    #{tag.inspect} => #{result.inspect}.freeze,\n" }
  output << "  }.freeze\nend\n"
  File.write(File.expand_path("../lib/antares/compatibility.rb", __dir__), output)
  document = +"# Lexer compatibility\n\nGenerated for Rouge #{Rouge.version}: three source variants, 50 deterministic edits each, and three distant-closure probes per lexer.\n\n"
  document << "| Lexer | Strategy | Passing checks | First failure |\n|---|---|---:|---|\n"
  results.each do |tag, result|
    document << "| `#{tag}` | `#{result[:strategy]}` | #{result[:checks] - result[:failures]}/#{result[:checks]} | #{result[:failure]&.fetch(:reason)} |\n"
  end
  FileUtils.mkdir_p(File.expand_path("../docs", __dir__))
  File.write(File.expand_path("../docs/compatibility.md", __dir__), document)
end
summary = {rouge: Rouge.version, lexers: results.length,
  incremental: results.values.count { |result| result[:strategy] == :incremental },
  checks: results.values.sum { |result| result[:checks] }}
summary[:details] = results if ENV["DETAILS"] == "1"
puts JSON.pretty_generate(summary)
